TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TELEPHONY_PROVIDER=telnyx
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_OUTBOUND_VOICE_PROFILE_ID=
TELNYX_PHONE_NUMBER=
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-2
OPENING_DELAY_SECONDS=0.5
DEEPGRAM_ENDPOINTING_MS=200
USER_AGGREGATION_TIMEOUT_SECONDS=0.45
AGENT_COMPLETE_DEBOUNCE_SECONDS=0.2
AGENT_FRAGMENT_DEBOUNCE_SECONDS=1.35
AGENT_FRAGMENT_MAX_HOLD_SECONDS=2.0
BASE_URL=
TARGET_PHONE=+18054398008
VERIFIED_TEST_PHONE=

# --- Telnyx playback diagnosis (see README) ---
# Inject stream_id into outbound media JSON. Set 0 to A/B test.
TELNYX_INJECT_STREAM_ID=1
# Known-good defaults only send stream_track + mode + codec. The extra
# bidirectional knobs below are opt-in because some combinations caused Telnyx
# 90046 connection failures.
TELNYX_STREAM_BIDIRECTIONAL_MODE=rtp
TELNYX_STREAM_BIDIRECTIONAL_CODEC=PCMU
# TELNYX_STREAM_BIDIRECTIONAL_TARGET_LEGS=both
# TELNYX_STREAM_BIDIRECTIONAL_SAMPLING_RATE=8000
# TELNYX_STREAM_ESTABLISH_BEFORE_CALL_ORIGINATE=true
# TELNYX_SEND_SILENCE_WHEN_IDLE=true
# Audio-path probe: send a test tone instead of the opener (bypasses LLM/TTS).
TELNYX_AUDIO_PROBE=0
TELNYX_PROBE_TONE_SECONDS=2.0
TELNYX_PROBE_REPEATS=3
TELNYX_PROBE_GAP_SECONDS=1.5
# Deterministic no-LLM reply when the agent asks only for the caller's name.
NAME_FASTPATH_ENABLED=1
